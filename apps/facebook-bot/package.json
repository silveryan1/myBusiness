{
  "name": "facebook-bot",
  "version": "1.0.0",
  "description": "Bot Facebook automatique pour la page SilverDev",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:post": "ts-node src/scripts/test-post.ts",
    "test:comment": "ts-node src/scripts/test-comment.ts",
    "test:message": "ts-node src/scripts/test-message.ts",
