# Variables d'environnement pour SilverDev Facebook Bot
# Copiez ce fichier en .env et remplissez vos valeurs

# ─── APPLICATION FACEBOOK ──────────────────────────────────────
# Depuis: developers.facebook.com → DigitalMaster → Paramètres de base
FACEBOOK_APP_ID=1654503223012170
FACEBOOK_APP_SECRET=VOTRE_APP_SECRET_ICI

# ─── PAGE FACEBOOK ─────────────────────────────────────────────
# ID de la page SilverDev
FACEBOOK_PAGE_ID=1365838339939707

# Token d'accès de la page (long-lived Page Access Token)
# À générer via: https://developers.facebook.com/tools/explorer
# Permissions requises: pages_manage_posts, pages_manage_engagement, 
#                       pages_messaging, pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=VOTRE_PAGE_ACCESS_TOKEN_ICI

# ─── WEBHOOK ───────────────────────────────────────────────────
# Token personnalisé pour vérifier les webhooks Facebook
# Choisissez n'importe quelle chaîne secrète (ex: silverdev_secret_2024)
FACEBOOK_VERIFY_TOKEN=silverdev_webhook_token_2024

# ─── SERVEUR ───────────────────────────────────────────────────
PORT=3001

# ─── ADMINISTRATION ────────────────────────────────────────────
# Token pour les endpoints admin (/admin/publish, /admin/status)
ADMIN_TOKEN=CHOISIR_UN_TOKEN_ADMIN_SECRET

# ─── ENVIRONNEMENT ─────────────────────────────────────────────
NODE_ENV=production
